{
  "name": "india-swe-jobs",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22" },
  "type": "module",
  "description": "India software-engineering job board for HFT/quant firms and tech companies. Architecture mirrored from a reverse-engineered Next.js job aggregator.",
  "scripts": {
    "ingest": "node scripts/ingest.mjs",
    "ingest:fresh": "node scripts/ingest.mjs --fresh",
    "ingest:dry": "node scripts/ingest.mjs --dry",
    "verify": "node scripts/verify-data.mjs",
    "shots": "node scripts/screenshots.mjs",
    "check-walkins": "node scripts/check-walkins.mjs",
    "dev": "next dev -p 4321",
    "build": "next build",
    "start": "next start -p 4321",
    "refresh": "node scripts/ingest.mjs && next build"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
